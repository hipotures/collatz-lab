theorem listed_no_rational_seed (r : Row) (hr : r ∈ catalogue) (p q : Int) :
    ¬ RealizesWord p q (Morphism.parityWord r.images) := by
  rcases catalogue_valid r hr with ⟨hL, _hL5, _hzero, _hone, h1, hw, hs, hd, hc, hgap⟩
  have hne : r.images.zero ≠ r.images.one := by
    intro he
    have hh : Morphism.image r.images false r.disagreement =
        Morphism.image r.images true r.disagreement := by simp [Morphism.image, hs, he]
    exact hd hh
  exact no_rational_seed_with_periodic_control hL r.images h1 hw hne r.control hc hgap p q

