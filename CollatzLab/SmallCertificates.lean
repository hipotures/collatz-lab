structure Row where
  L : Nat
  zeroMask : Nat
  oneMask : Nat
  period : Nat
  controlMask : Nat
  order : Nat
  disagreement : Nat
deriving DecidableEq

def Row.images (r : Row) : Morphism.Images r.L where
  zero := fun j => r.zeroMask.testBit j.val
  one := fun j => r.oneMask.testBit j.val

def Row.control (r : Row) : PeriodicControl where
  period := r.period
  block := fun j => r.controlMask.testBit j.val
  order := r.order

def Row.Valid (r : Row) : Prop :=
  2 ≤ r.L ∧ r.L ≤ 5 ∧ r.zeroMask < 2 ^ r.L ∧ r.oneMask < 2 ^ r.L ∧
  Morphism.image r.images true 0 = true ∧
  Morphism.weight (Morphism.image r.images false) r.L =
    Morphism.weight (Morphism.image r.images true) r.L ∧
  r.disagreement < r.L ∧
  Morphism.image r.images false r.disagreement ≠ Morphism.image r.images true r.disagreement ∧
  r.control.Valid r.images ∧ r.control.Gap r.images

instance (r : Row) : Decidable r.Valid := by
  unfold Row.Valid PeriodicControl.Valid PeriodicControl.Gap
  infer_instance

