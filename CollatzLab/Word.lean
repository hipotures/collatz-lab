/-
  CollatzLab.Word:
  Formalization of the 4-uniform Collatz survivor morphism word `w = lim μ^j(1)`
  (`μ(1) = 1110`, `μ(0) = 1101`), Lemma 3.1 (base-4 recurrence), Theorem 3.1
  (all-prefix survival `3^(r_k) > 2^k`), Theorem 3.2 (aperiodicity of `w`), and
  the accelerated Collatz map on rational 2-adic seeds `x = p / q` (`q > 0` odd).
-/

namespace CollatzLab

/-- Fuel-based structural definition of the 4-uniform morphism fixed point `w`. -/
def wAux : Nat → Nat → Int
  | 0, _ => 1
  | _ + 1, 0 => 1
  | fuel + 1, n =>
    let q := n / 4
    let r := n % 4
    if r = 0 then 1
    else if r = 1 then 1
    else if r = 2 then wAux fuel q
    else 1 - wAux fuel q

/-- The canonical infinite parity word `w(n) ∈ {0, 1}` generated by `μ(1)=1110, μ(0)=1101`. -/
def w (n : Nat) : Int :=
  wAux n n

theorem wAux_eq_of_le : ∀ (f1 f2 n : Nat), n ≤ f1 → n ≤ f2 → wAux f1 n = wAux f2 n
  | 0, 0, _, _, _ => rfl
  | 0, _ + 1, n, h1, _ => by
    have hn : n = 0 := by omega
    subst hn
    rfl
  | _ + 1, 0, n, _, h2 => by
    have hn : n = 0 := by omega
    subst hn
    rfl
  | f1 + 1, f2 + 1, n, h1, h2 => by
    by_cases hn : n = 0
    · subst hn; rfl
    · unfold wAux
      simp only [hn]
      have hq1 : n / 4 ≤ f1 := by omega
      have hq2 : n / 4 ≤ f2 := by omega
      have ih := wAux_eq_of_le f1 f2 (n / 4) hq1 hq2
      rw [ih]

theorem wAux_ge (fuel n : Nat) (h : n ≤ fuel) : wAux fuel n = w n :=
  wAux_eq_of_le fuel n n h (Nat.le_refl n)

@[simp]
theorem w_zero : w 0 = 1 := rfl

/-- Lemma 3.1(a): `w(4n) = 1` for all `n ≥ 0`. -/
@[simp]
theorem w_mul4 (n : Nat) : w (4 * n) = 1 := by
  by_cases hn : n = 0
  · subst hn; rfl
  · rw [← wAux_ge (4 * n + 1) (4 * n) (by omega)]
    unfold wAux
    have hne : 4 * n ≠ 0 := by omega
    have hmod : (4 * n) % 4 = 0 := by omega
    simp [hne, hmod]

/-- Lemma 3.1(b): `w(4n + 1) = 1` for all `n ≥ 0`. -/
@[simp]
theorem w_mul4_add1 (n : Nat) : w (4 * n + 1) = 1 := by
  rw [← wAux_ge (4 * n + 1) (4 * n + 1) (by omega)]
  unfold wAux
  have hmod : (4 * n + 1) % 4 = 1 := by omega
  simp [hmod]

/-- Lemma 3.1(c): `w(4n + 2) = w(n)` for all `n ≥ 0`. -/
@[simp]
theorem w_mul4_add2 (n : Nat) : w (4 * n + 2) = w n := by
  rw [← wAux_ge (4 * n + 2) (4 * n + 2) (by omega)]
  unfold wAux
  have hdiv : (4 * n + 2) / 4 = n := by omega
  have hmod : (4 * n + 2) % 4 = 2 := by omega
  simp [hdiv, hmod, wAux_ge (4 * n + 1) n (by omega)]

/-- Lemma 3.1(d): `w(4n + 3) = 1 - w(n)` for all `n ≥ 0`. -/
@[simp]
theorem w_mul4_add3 (n : Nat) : w (4 * n + 3) = 1 - w n := by
  rw [← wAux_ge (4 * n + 3) (4 * n + 3) (by omega)]
  unfold wAux
  have hdiv : (4 * n + 3) / 4 = n := by omega
  have hmod : (4 * n + 3) % 4 = 3 := by omega
  simp [hdiv, hmod, wAux_ge (4 * n + 2) n (by omega)]

theorem wAux_binary : ∀ (fuel n : Nat), wAux fuel n = 0 ∨ wAux fuel n = 1
  | 0, _ => Or.inr rfl
  | _ + 1, 0 => Or.inr rfl
  | fuel + 1, n => by
    by_cases hn : n = 0
    · subst hn; exact Or.inr rfl
    · unfold wAux
      simp only [hn]
      have ih := wAux_binary fuel (n / 4)
      split
      · exact Or.inr rfl
      · split
        · exact Or.inr rfl
        · split
          · exact ih
          · rcases ih with h0 | h1
            · right; omega
            · left; omega

/-- Every symbol of `w` lies in `{0, 1}`. -/
theorem w_binary (n : Nat) : w n = 0 ∨ w n = 1 :=
  wAux_binary n n

theorem w_nonneg (n : Nat) : 0 ≤ w n := by
  rcases w_binary n with h | h <;> omega

theorem w_le_one (n : Nat) : w n ≤ 1 := by
  rcases w_binary n with h | h <;> omega

/-- Number of odd steps `r_k = ∑_{i=0}^{k-1} w(i)` in the length-`k` prefix of `w`. -/
def oddSteps : Nat → Nat
  | 0 => 0
  | k + 1 => oddSteps k + (w k).toNat

theorem oddSteps_mul4 : ∀ q : Nat, oddSteps (4 * q) = 3 * q
  | 0 => rfl
  | q + 1 => by
    have h4 : 4 * (q + 1) = 4 * q + 4 := by omega
    rw [h4]
    dsimp [oddSteps]
    have h0 : w (4 * q) = 1 := w_mul4 q
    have h1 : w (4 * q + 1) = 1 := w_mul4_add1 q
    have h2 : w (4 * q + 2) = w q := w_mul4_add2 q
    have h3 : w (4 * q + 3) = 1 - w q := w_mul4_add3 q
    rw [h0, h1, h2, h3, oddSteps_mul4 q]
    rcases w_binary q with hq0 | hq1
    · rw [hq0]; omega
    · rw [hq1]; omega

theorem pow16_eq_pow2 (q : Nat) : 16 ^ q = 2 ^ (4 * q) := by
  induction q with
  | zero => rfl
  | succ q ih =>
    have h4 : 4 * (q + 1) = 4 * q + 4 := by omega
    rw [Nat.pow_succ, ih, h4, Nat.pow_add]

theorem pow27_eq_pow3 (q : Nat) : 27 ^ q = 3 ^ (3 * q) := by
  induction q with
  | zero => rfl
  | succ q ih =>
    have h3 : 3 * (q + 1) = 3 * q + 3 := by omega
    rw [Nat.pow_succ, ih, h3, Nat.pow_add]

/-- Theorem 3.1 (strong form): `(3^(r_k)) / (2^k) ≥ (9/8) * (27/16)^⌊(k-1)/4⌋` for all `k ≥ 1`. -/
theorem all_prefixes_survive_strong (k : Nat) (hk : k ≥ 1) :
    8 * (16 ^ ((k - 1) / 4)) * (3 ^ oddSteps k) ≥
      9 * (27 ^ ((k - 1) / 4)) * (2 ^ k) := by
  have ⟨q, hq_eq, hr⟩ : ∃ q : Nat, (k - 1) / 4 = q ∧
      (k = 4 * q + 1 ∨ k = 4 * q + 2 ∨ k = 4 * q + 3 ∨ k = 4 * q + 4) :=
    ⟨(k - 1) / 4, rfl, by omega⟩
  rw [hq_eq]
  let A := (16 ^ q) * (27 ^ q)
  have hA : A = (16 ^ q) * (27 ^ q) := rfl
  rcases hr with hk1 | hk2 | hk3 | hk4
  · rw [hk1]
    have hodds : oddSteps (4 * q + 1) = 3 * q + 1 := by
      dsimp [oddSteps]; rw [oddSteps_mul4 q, w_mul4 q]; rfl
    rw [hodds, Nat.pow_add 3 (3 * q) 1, Nat.pow_add 2 (4 * q) 1, ← pow27_eq_pow3 q, ← pow16_eq_pow2 q]
    have h1 : 8 * 16 ^ q * (27 ^ q * 3 ^ 1) = 8 * (3 ^ 1 * A) := by dsimp [A]; ac_rfl
    have h2 : 9 * 27 ^ q * (16 ^ q * 2 ^ 1) = 9 * (2 ^ 1 * A) := by dsimp [A]; ac_rfl
    rw [h1, h2]; omega
  · rw [hk2]
    have hodds : oddSteps (4 * q + 2) = 3 * q + 2 := by
      dsimp [oddSteps]; rw [oddSteps_mul4 q, w_mul4 q, w_mul4_add1 q]; rfl
    rw [hodds, Nat.pow_add 3 (3 * q) 2, Nat.pow_add 2 (4 * q) 2, ← pow27_eq_pow3 q, ← pow16_eq_pow2 q]
    have h1 : 8 * 16 ^ q * (27 ^ q * 3 ^ 2) = 8 * (3 ^ 2 * A) := by dsimp [A]; ac_rfl
    have h2 : 9 * 27 ^ q * (16 ^ q * 2 ^ 2) = 9 * (2 ^ 2 * A) := by dsimp [A]; ac_rfl
    rw [h1, h2]; omega
  · rw [hk3]
    have hodds : oddSteps (4 * q + 3) = 3 * q + 2 + (w q).toNat := by
      dsimp [oddSteps]; rw [oddSteps_mul4 q, w_mul4 q, w_mul4_add1 q, w_mul4_add2 q]; omega
    rw [hodds, Nat.pow_add 2 (4 * q) 3, ← pow16_eq_pow2 q]
    rcases w_binary q with hq0 | hq1
    · rw [hq0]
      change 8 * 16 ^ q * 3 ^ (3 * q + 2) ≥ 9 * 27 ^ q * (16 ^ q * 2 ^ 3)
      rw [Nat.pow_add 3 (3 * q) 2, ← pow27_eq_pow3 q]
      have h1 : 8 * 16 ^ q * (27 ^ q * 3 ^ 2) = 8 * (3 ^ 2 * A) := by dsimp [A]; ac_rfl
      have h2 : 9 * 27 ^ q * (16 ^ q * 2 ^ 3) = 9 * (2 ^ 3 * A) := by dsimp [A]; ac_rfl
      rw [h1, h2]; omega
    · rw [hq1]
      change 8 * 16 ^ q * 3 ^ (3 * q + 3) ≥ 9 * 27 ^ q * (16 ^ q * 2 ^ 3)
      rw [Nat.pow_add 3 (3 * q) 3, ← pow27_eq_pow3 q]
      have h1 : 8 * 16 ^ q * (27 ^ q * 3 ^ 3) = 8 * (3 ^ 3 * A) := by dsimp [A]; ac_rfl
      have h2 : 9 * 27 ^ q * (16 ^ q * 2 ^ 3) = 9 * (2 ^ 3 * A) := by dsimp [A]; ac_rfl
      rw [h1, h2]; omega
  · rw [hk4]
    have h4 : 4 * q + 4 = 4 * (q + 1) := by omega
    have hodds : oddSteps (4 * q + 4) = 3 * q + 3 := by
      rw [h4, oddSteps_mul4 (q + 1)]; omega
    rw [hodds, Nat.pow_add 3 (3 * q) 3, Nat.pow_add 2 (4 * q) 4, ← pow27_eq_pow3 q, ← pow16_eq_pow2 q]
    have h1 : 8 * 16 ^ q * (27 ^ q * 3 ^ 3) = 8 * (3 ^ 3 * A) := by dsimp [A]; ac_rfl
    have h2 : 9 * 27 ^ q * (16 ^ q * 2 ^ 4) = 9 * (2 ^ 4 * A) := by dsimp [A]; ac_rfl
    rw [h1, h2]; omega

theorem pow16_le_pow27 : ∀ q : Nat, 16 ^ q ≤ 27 ^ q ∧ 1 ≤ 16 ^ q
  | 0 => ⟨by decide, by decide⟩
  | q + 1 => by
    rcases pow16_le_pow27 q with ⟨h1, h2⟩
    rw [Nat.pow_succ, Nat.pow_succ]
    refine ⟨?_, by omega⟩
    have : 16 ^ q * 16 ≤ 27 ^ q * 16 := Nat.mul_le_mul_right 16 h1
    omega

/-- Theorem 3.1: Every non-empty prefix of `w` satisfies `3^(r_k) > 2^k`. -/
theorem all_prefixes_survive (k : Nat) (hk : k ≥ 1) :
    3 ^ oddSteps k > 2 ^ k := by
  have hstrong := all_prefixes_survive_strong k hk
  rcases pow16_le_pow27 ((k - 1) / 4) with ⟨hq_le, hq_pos⟩
  have h2_pos : 2 ^ k ≥ 1 := by
    clear hstrong hq_le hq_pos hk
    induction k with
    | zero => decide
    | succ k ih => rw [Nat.pow_succ]; omega
  have h_trich : 3 ^ oddSteps k ≤ 2 ^ k ∨ 3 ^ oddSteps k > 2 ^ k := by omega
  rcases h_trich with hle' | hgt
  · have h1 : 8 * (16 ^ ((k - 1) / 4)) * (3 ^ oddSteps k) ≤ 8 * (16 ^ ((k - 1) / 4)) * (2 ^ k) :=
      Nat.mul_le_mul_left (8 * (16 ^ ((k - 1) / 4))) hle'
    have h2 : 8 * (16 ^ ((k - 1) / 4)) * (2 ^ k) < 9 * (27 ^ ((k - 1) / 4)) * (2 ^ k) := by
      have : 8 * (16 ^ ((k - 1) / 4)) < 9 * (27 ^ ((k - 1) / 4)) := by omega
      exact Nat.mul_lt_mul_of_pos_right this (by omega)
    omega
  · exact hgt

/-- Eventual periodicity predicate for an infinite sequence `v : Nat → Int`. -/
def EventuallyPeriodic (v : Nat → Int) : Prop :=
  ∃ M : Nat, ∃ p : Nat, p ≥ 1 ∧ ∀ m : Nat, m ≥ M → v (m + p) = v m

theorem not_periodic_from (p : Nat) :
    ∀ M : Nat, p ≥ 1 → (∀ m : Nat, m ≥ M → w (m + p) = w m) → False := by
  induction p using Nat.strongRecOn with
  | ind p ih =>
    intro M hp hper
    have hmod : p % 4 = 0 ∨ p % 4 = 1 ∨ p % 4 = 2 ∨ p % 4 = 3 := by omega
    rcases hmod with h0 | h1 | h2 | h3
    · let p' := p / 4
      have hp' : p' < p := by omega
      have hp'_pos : p' ≥ 1 := by omega
      refine ih p' hp' M hp'_pos (fun n hn => ?_)
      have hm : 4 * n + 2 ≥ M := by omega
      have hstep := hper (4 * n + 2) hm
      have hrew : (4 * n + 2) + p = 4 * (n + p') + 2 := by omega
      rw [hrew, w_mul4_add2 (n + p'), w_mul4_add2 n] at hstep
      exact hstep
    · let q := p / 4
      have hp_eq : p = 4 * q + 1 := by omega
      have h_a := hper (4 * (M + q) + 1) (by omega)
      have ha_idx : (4 * (M + q) + 1) + p = 4 * (M + 2 * q) + 2 := by omega
      rw [ha_idx, w_mul4_add2 (M + 2 * q), w_mul4_add1 (M + q)] at h_a
      have h_b := hper (4 * (M + 2 * q) + 1) (by omega)
      have hb_idx : (4 * (M + 2 * q) + 1) + p = 4 * (M + 3 * q) + 2 := by omega
      rw [hb_idx, w_mul4_add2 (M + 3 * q), w_mul4_add1 (M + 2 * q)] at h_b
      have h_c := hper (4 * (M + 2 * q) + 2) (by omega)
      have hc_idx : (4 * (M + 2 * q) + 2) + p = 4 * (M + 3 * q) + 3 := by omega
      rw [hc_idx, w_mul4_add3 (M + 3 * q), w_mul4_add2 (M + 2 * q)] at h_c
      omega
    · let q := p / 4
      have hp_eq : p = 4 * q + 2 := by omega
      have h_a := hper (4 * (4 * M + 3 * q) + 1) (by omega)
      have ha_idx : (4 * (4 * M + 3 * q) + 1) + p = 4 * (4 * (M + q)) + 3 := by omega
      rw [ha_idx, w_mul4_add3 (4 * (M + q)), w_mul4 (M + q), w_mul4_add1 (4 * M + 3 * q)] at h_a
      omega
    · let q := p / 4
      have hp_eq : p = 4 * q + 3 := by omega
      have h_a := hper (4 * (4 * M + 3 * q)) (by omega)
      have ha_idx : 4 * (4 * M + 3 * q) + p = 4 * (4 * (M + q)) + 3 := by omega
      rw [ha_idx, w_mul4_add3 (4 * (M + q)), w_mul4 (M + q), w_mul4 (4 * M + 3 * q)] at h_a
      omega

/-- Theorem 3.2: The infinite word `w` is not eventually periodic. -/
theorem w_not_eventually_periodic : ¬ EventuallyPeriodic w := by
  rintro ⟨M, p, hp, hper⟩
  exact not_periodic_from p M hp hper

/-- Accelerated Collatz step on integers `T(n) = n/2` (even) or `(3n+1)/2` (odd). -/
def tStepInt (n : Int) : Int :=
  if n % 2 = 0 then n / 2 else (3 * n + 1) / 2

/-- Iterated accelerated Collatz map `T^j(n)` on integers. -/
def tIterInt (n : Int) : Nat → Int
  | 0 => n
  | j + 1 => tStepInt (tIterInt n j)

/--
  Denominator-preserving numerator step for a rational 2-adic seed `x = p / q`
  with odd denominator `q`:
  `T(p / q) = (numStep q p) / q`.
-/
def numStep (q p : Int) : Int :=
  if p % 2 = 0 then p / 2 else (3 * p + q) / 2

/-- Iterated numerator `p_j` such that `T^j(p / q) = p_j / q`. -/
def numIter (q p : Int) : Nat → Int
  | 0 => p
  | j + 1 => numStep q (numIter q p j)

/-- The 2-adic parity `(T^j(p / q) mod 2) ∈ {0, 1}` of `x = p / q` (`q` odd) at step `j`. -/
def seedParity (q p : Int) (j : Nat) : Int :=
  (numIter q p j) % 2

/--
  A rational 2-adic seed `(p, q)` (`p, q ∈ ℤ`, `q > 0` odd) realizes an infinite
  parity word `v : Nat → Int` if its parity itinerary equals `v(j)` at every index `j ≥ 0`.
-/
def RealizesWord (p q : Int) (v : Nat → Int) : Prop :=
  q > 0 ∧ q % 2 = 1 ∧ ∀ j : Nat, seedParity q p j = v j

theorem numStep_one (p : Int) : numStep 1 p = tStepInt p := by
  unfold numStep tStepInt
  simp

theorem numIter_one (p : Int) : ∀ j : Nat, numIter 1 p j = tIterInt p j
  | 0 => rfl
  | j + 1 => by
    dsimp [numIter, tIterInt]
    rw [numIter_one p j, numStep_one]

/-- Exact division equation for `numStep q p` when `q` is odd (Theorem 6.2(1)). -/
theorem numStep_eq (q p : Int) (hq : q % 2 = 1) :
    (p % 2 = 0 → 2 * numStep q p = p) ∧
    (p % 2 = 1 → 2 * numStep q p = 3 * p + q) := by
  unfold numStep
  constructor <;> intro hp <;> simp [hp] <;> omega

/-- Exact step equation along any realized binary parity sequence `v`. -/
theorem numIter_step_eq {p q : Int} {v : Nat → Int} (hq : q % 2 = 1)
    (hj : seedParity q p j = v j) :
    (v j = 0 → 2 * numIter q p (j + 1) = numIter q p j) ∧
    (v j = 1 → 2 * numIter q p (j + 1) = 3 * numIter q p j + q) := by
  dsimp [numIter]
  unfold seedParity at hj
  have hstep := numStep_eq q (numIter q p j) hq
  omega

/-- Helper: if `p * q' = p' * q` with `q, q'` odd, then `p % 2 = p' % 2`. -/
theorem mod2_eq_of_mul_odd_eq {p q p' q' : Int} (hq : q % 2 = 1) (hq' : q' % 2 = 1)
    (heq : p * q' = p' * q) : p % 2 = p' % 2 := by
  have hq_decomp : q = 2 * (q / 2) + 1 := by omega
  have hq'_decomp : q' = 2 * (q' / 2) + 1 := by omega
  have h1 : p * (2 * (q' / 2) + 1) = p * (2 * (q' / 2)) + p := by
    rw [Int.mul_add, Int.mul_one]
  have h2 : p' * (2 * (q / 2) + 1) = p' * (2 * (q / 2)) + p' := by
    rw [Int.mul_add, Int.mul_one]
  have h3 : p * (2 * (q' / 2)) = 2 * (p * (q' / 2)) := by ac_rfl
  have h4 : p' * (2 * (q / 2)) = 2 * (p' * (q / 2)) := by ac_rfl
  rw [← hq'_decomp] at h1
  rw [← hq_decomp] at h2
  omega

/--
  Well-definedness of the rational 2-adic itinerary under equivalent fractions:
  if `p * q' = p' * q` with `q, q' > 0` odd, then `(numIter q p j) * q' = (numIter q' p' j) * q`
  and `seedParity q p j = seedParity q' p' j` for all `j ≥ 0`.
-/
theorem numIter_equiv {p q p' q' : Int} (hq : q % 2 = 1) (hq' : q' % 2 = 1)
    (heq : p * q' = p' * q) :
    ∀ j : Nat, (numIter q p j) * q' = (numIter q' p' j) * q ∧
      seedParity q p j = seedParity q' p' j
  | 0 => by
    dsimp [numIter, seedParity]
    exact ⟨heq, mod2_eq_of_mul_odd_eq hq hq' heq⟩
  | j + 1 => by
    rcases numIter_equiv hq hq' heq j with ⟨hij, hpar⟩
    let pj := numIter q p j
    let pj' := numIter q' p' j
    have hpj_def : pj = numIter q p j := rfl
    have hpj'_def : pj' = numIter q' p' j := rfl
    unfold seedParity at hpar
    rw [← hpj_def, ← hpj'_def] at hij hpar
    have hstep1 := numStep_eq q pj hq
    have hstep2 := numStep_eq q' pj' hq'
    have hnext : (numIter q p (j + 1)) * q' = (numIter q' p' (j + 1)) * q := by
      dsimp [numIter]
      rw [← hpj_def, ← hpj'_def]
      by_cases hp0 : pj % 2 = 0
      · have hp0' : pj' % 2 = 0 := by omega
        have hs1 := hstep1.1 hp0
        have hs2 := hstep2.1 hp0'
        have hmul1 : (2 * numStep q pj) * q' = pj * q' := by rw [hs1]
        have hmul2 : (2 * numStep q' pj') * q = pj' * q := by rw [hs2]
        have h_assoc1 : (2 * numStep q pj) * q' = 2 * (numStep q pj * q') := by ac_rfl
        have h_assoc2 : (2 * numStep q' pj') * q = 2 * (numStep q' pj' * q) := by ac_rfl
        omega
      · have hp1 : pj % 2 = 1 := by omega
        have hp1' : pj' % 2 = 1 := by omega
        have hs1 := hstep1.2 hp1
        have hs2 := hstep2.2 hp1'
        have hmul1 : (2 * numStep q pj) * q' = (3 * pj + q) * q' := by rw [hs1]
        have hmul2 : (2 * numStep q' pj') * q = (3 * pj' + q') * q := by rw [hs2]
        have h_exp1 : (3 * pj + q) * q' = 3 * (pj * q') + q * q' := by
          rw [Int.add_mul, Int.mul_assoc]
        have h_exp2 : (3 * pj' + q') * q = 3 * (pj' * q) + q * q' := by
          rw [Int.add_mul, Int.mul_assoc, Int.mul_comm q' q]
        have h_assoc1 : (2 * numStep q pj) * q' = 2 * (numStep q pj * q') := by ac_rfl
        have h_assoc2 : (2 * numStep q' pj') * q = 2 * (numStep q' pj' * q) := by ac_rfl
        omega
    refine ⟨hnext, ?_⟩
    unfold seedParity
    exact mod2_eq_of_mul_odd_eq hq hq' hnext

end CollatzLab
